<?xml version="1.0" encoding="utf-8"?>
<List xmlns:ows="Microsoft SharePoint" Title="Employees"
      Direction="$Resources:Direction;"
      Url="Lists/Employees"
      BaseType="0"
      xmlns="http://schemas.microsoft.com/sharepoint/">
  <MetaData>
    <ContentTypes>
      <ContentTypeRef ID="0x01" />
    </ContentTypes>
    <Fields>
      <!-- Employee ID (Indexed for performance) -->
      <Field Name="JMLEmployeeId"
             ID="{A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D}"
             DisplayName="Employee ID"
             Type="Text"
             Required="TRUE"
             Indexed="TRUE"
             MaxLength="50"
             Group="JML Columns" />

      <!-- Full Name -->
      <Field Name="JMLFullName"
             ID="{11111111-1111-1111-1111-111111111111}"
             DisplayName="Full Name"
             Type="Text"
             Required="TRUE"
             Indexed="TRUE"
             MaxLength="255"
             Group="JML Columns" />

      <!-- Email -->
      <Field Name="JMLEmail"
             ID="{22222222-2222-2222-2222-222222222222}"
             DisplayName="Email"
             Type="Text"
             Required="TRUE"
             Indexed="TRUE"
             MaxLength="255"
             Group="JML Columns" />

      <!-- Employee Type -->
      <Field Name="JMLEmployeeType"
             ID="{B2C3D4E5-F6A7-4B5C-8D9E-0F1A2B3C4D5E}"
             DisplayName="Employee Type"
             Type="Choice"
             Required="TRUE"
             Indexed="TRUE"
             Group="JML Columns">
        <CHOICES>
          <CHOICE>Full-Time</CHOICE>
          <CHOICE>Part-Time</CHOICE>
          <CHOICE>Contractor</CHOICE>
          <CHOICE>Intern</CHOICE>
          <CHOICE>Temporary</CHOICE>
        </CHOICES>
        <Default>Full-Time</Default>
      </Field>

      <!-- Department (Indexed for filtering) -->
      <Field Name="JMLDepartment"
             ID="{33333333-3333-3333-3333-333333333333}"
             DisplayName="Department"
             Type="Text"
             Required="TRUE"
             Indexed="TRUE"
             MaxLength="100"
             Group="JML Columns" />

      <!-- Job Title -->
      <Field Name="JMLJobTitle"
             ID="{44444444-4444-4444-4444-444444444444}"
             DisplayName="Job Title"
             Type="Text"
             Required="TRUE"
             MaxLength="100"
             Group="JML Columns" />

      <!-- Manager (User field) -->
      <Field Name="JMLManager"
             ID="{55555555-5555-5555-5555-555555555555}"
             DisplayName="Manager"
             Type="User"
             Required="FALSE"
             UserSelectionMode="PeopleOnly"
             UserSelectionScope="0"
             Group="JML Columns" />

      <!-- Start Date (Indexed for performance) -->
      <Field Name="JMLStartDate"
             ID="{66666666-6666-6666-6666-666666666666}"
             DisplayName="Start Date"
             Type="DateTime"
             Format="DateOnly"
             Required="TRUE"
             Indexed="TRUE"
             Group="JML Columns" />

      <!-- End Date -->
      <Field Name="JMLEndDate"
             ID="{77777777-7777-7777-7777-777777777777}"
             DisplayName="End Date"
             Type="DateTime"
             Format="DateOnly"
             Required="FALSE"
             Group="JML Columns" />

      <!-- Office Location -->
      <Field Name="JMLOfficeLocation"
             ID="{88888888-8888-8888-8888-888888888888}"
             DisplayName="Office Location"
             Type="Text"
             Required="FALSE"
             MaxLength="100"
             Group="JML Columns" />

      <!-- Employee Status (Indexed for filtering) -->
      <Field Name="JMLEmployeeStatus"
             ID="{C3D4E5F6-A7B8-4C5D-8E9F-0A1B2C3D4E5F}"
             DisplayName="Employee Status"
             Type="Choice"
             Required="TRUE"
             Indexed="TRUE"
             Group="JML Columns">
        <CHOICES>
          <CHOICE>Pre-Boarding</CHOICE>
          <CHOICE>Active</CHOICE>
          <CHOICE>On Leave</CHOICE>
          <CHOICE>Notice Period</CHOICE>
          <CHOICE>Departed</CHOICE>
        </CHOICES>
        <Default>Pre-Boarding</Default>
      </Field>

      <!-- JML Status (Indexed for performance) -->
      <Field Name="JMLStatus"
             ID="{D4E5F6A7-B8C9-4D5E-8F9A-0B1C2D3E4F5A}"
             DisplayName="JML Status"
             Type="Choice"
             Required="FALSE"
             Indexed="TRUE"
             Group="JML Columns">
        <CHOICES>
          <CHOICE>None</CHOICE>
          <CHOICE>Onboarding</CHOICE>
          <CHOICE>Transfer</CHOICE>
          <CHOICE>Offboarding</CHOICE>
        </CHOICES>
        <Default>None</Default>
      </Field>

      <!-- Phone Number -->
      <Field Name="JMLPhoneNumber"
             ID="{99999999-9999-9999-9999-999999999999}"
             DisplayName="Phone Number"
             Type="Text"
             Required="FALSE"
             MaxLength="50"
             Group="JML Columns" />

      <!-- Cost Center -->
      <Field Name="JMLCostCenter"
             ID="{AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA}"
             DisplayName="Cost Center"
             Type="Text"
             Required="FALSE"
             MaxLength="50"
             Group="JML Columns" />

      <!-- Work Location Type -->
      <Field Name="JMLWorkLocationType"
             ID="{BBBBBBBB-BBBB-BBBB-BBBB-BBBBBBBBBBBB}"
             DisplayName="Work Location Type"
             Type="Choice"
             Required="FALSE"
             Group="JML Columns">
        <CHOICES>
          <CHOICE>On-Site</CHOICE>
          <CHOICE>Remote</CHOICE>
          <CHOICE>Hybrid</CHOICE>
        </CHOICES>
        <Default>On-Site</Default>
      </Field>

      <!-- Entra ID Object ID -->
      <Field Name="JMLEntraIDObjectId"
             ID="{CCCCCCCC-CCCC-CCCC-CCCC-CCCCCCCCCCCC}"
             DisplayName="Entra ID Object ID"
             Type="Text"
             Required="FALSE"
             MaxLength="100"
             Group="JML Columns" />

      <!-- Notes -->
      <Field Name="JMLNotes"
             ID="{DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD}"
             DisplayName="Notes"
             Type="Note"
             Required="FALSE"
             NumLines="6"
             RichText="FALSE"
             Group="JML Columns" />
    </Fields>
    <Views>
      <View BaseViewID="1" Type="HTML" WebPartZoneID="Main" DisplayName="All Employees"
            DefaultView="TRUE" MobileView="TRUE" MobileDefaultView="TRUE"
            SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png"
            Url="AllItems.aspx">
        <XslLink Default="TRUE">main.xsl</XslLink>
        <JSLink>clienttemplates.js</JSLink>
        <RowLimit Paged="TRUE">30</RowLimit>
        <Toolbar Type="Standard" />
        <ViewFields>
          <FieldRef Name="JMLEmployeeId" />
          <FieldRef Name="JMLFullName" />
          <FieldRef Name="JMLEmail" />
          <FieldRef Name="JMLDepartment" />
          <FieldRef Name="JMLJobTitle" />
          <FieldRef Name="JMLEmployeeStatus" />
          <FieldRef Name="JMLStatus" />
          <FieldRef Name="JMLStartDate" />
        </ViewFields>
        <Query>
          <OrderBy>
            <FieldRef Name="JMLFullName" Ascending="TRUE" />
          </OrderBy>
        </Query>
      </View>
      <View BaseViewID="2" Type="HTML" WebPartZoneID="Main" DisplayName="Active Employees"
            DefaultView="FALSE" MobileView="FALSE" MobileDefaultView="FALSE"
            SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png"
            Url="ActiveEmployees.aspx">
        <XslLink Default="TRUE">main.xsl</XslLink>
        <JSLink>clienttemplates.js</JSLink>
        <RowLimit Paged="TRUE">30</RowLimit>
        <Toolbar Type="Standard" />
        <ViewFields>
          <FieldRef Name="JMLEmployeeId" />
          <FieldRef Name="JMLFullName" />
          <FieldRef Name="JMLEmail" />
          <FieldRef Name="JMLDepartment" />
          <FieldRef Name="JMLJobTitle" />
          <FieldRef Name="JMLStatus" />
        </ViewFields>
        <Query>
          <Where>
            <Eq>
              <FieldRef Name="JMLEmployeeStatus" />
              <Value Type="Choice">Active</Value>
            </Eq>
          </Where>
          <OrderBy>
            <FieldRef Name="JMLFullName" Ascending="TRUE" />
          </OrderBy>
        </Query>
      </View>
      <View BaseViewID="3" Type="HTML" WebPartZoneID="Main" DisplayName="Active JML Processes"
            DefaultView="FALSE" MobileView="FALSE" MobileDefaultView="FALSE"
            SetupPath="pages\viewpage.aspx" ImageUrl="/_layouts/15/images/generic.png"
            Url="ActiveJMLProcesses.aspx">
        <XslLink Default="TRUE">main.xsl</XslLink>
        <JSLink>clienttemplates.js</JSLink>
        <RowLimit Paged="TRUE">30</RowLimit>
        <Toolbar Type="Standard" />
        <ViewFields>
          <FieldRef Name="JMLEmployeeId" />
          <FieldRef Name="JMLFullName" />
          <FieldRef Name="JMLDepartment" />
          <FieldRef Name="JMLStatus" />
          <FieldRef Name="JMLStartDate" />
        </ViewFields>
        <Query>
          <Where>
            <Neq>
              <FieldRef Name="JMLStatus" />
              <Value Type="Choice">None</Value>
            </Neq>
          </Where>
          <OrderBy>
            <FieldRef Name="JMLStartDate" Ascending="FALSE" />
          </OrderBy>
        </Query>
      </View>
    </Views>
  </MetaData>
</List>
